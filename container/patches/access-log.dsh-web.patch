+/** Access-log record: one JSONL line per completed HTTP request. */
+interface AccessLogEntry {
+  ts: string
+  svc: string
+  method: string
+  path: string
+  status: number
+  durMs: number
+  remote: string
+  host: string
+}
+
+/**
+ * Append one dsh-web access-log line to
+ * $DSH_HOME/fleet/logs/dsh-web.requests.jsonl (dir created on demand).
+ * Fire-and-forget and best-effort: a logging failure is swallowed so request
+ * routing never depends on the log write.
+ */
+function writeAccessLog(entry: AccessLogEntry): void {
+  const home = process.env.DSH_HOME
+  if (!home) return
+  const dir = `${home}/fleet/logs`
+  const line = `${JSON.stringify(entry)}\n`
+  void (async () => {
+    try {
+      await mkdir(dir, { recursive: true })
+      await appendFile(`${dir}/dsh-web.requests.jsonl`, line, 'utf8')
+    } catch {
+      // access logging is best-effort; routing must never depend on it
+    }
+  })()
+}
+
+/**
+ * Attach access-log tracing to one request/response pair. Logs exactly once:
+ * response finish emits the real status; a response error or an aborted
+ * connection emits status 0 (the request never completed).
+ */
+function traceAccess(req: IncomingMessage, res: ServerResponse): void {
+  const started = Date.now()
+  let logged = false
+  const emit = (status: number): void => {
+    if (logged) return
+    logged = true
+    let path = req.url ?? '/'
+    try {
+      path = new URL(path, 'http://x').pathname
+    } catch {
+      // keep the raw url when the request target is not URL-parseable
+    }
+    writeAccessLog({
+      ts: new Date().toISOString(),
+      svc: 'dsh-web',
+      method: req.method ?? 'GET',
+      path,
+      status,
+      durMs: Date.now() - started,
+      remote: req.socket.remoteAddress ?? '',
+      host: req.headers.host ?? '',
+    })
+  }
+  res.once('finish', () => emit(res.statusCode))
+  res.once('error', () => emit(0))
+  res.once('close', () => emit(0))
+}
+
